# demo completes locally without downloading a video or calling OpenRouter.
# Supported values: demo, test, real
FRAMEPAGE_MODE=demo

# Local commands use this directory. Docker Compose overrides it with /data.
FRAMEPAGE_DATA_DIR=.framepage-data
# Leave empty to use FRAMEPAGE_DATA_DIR/framepage.sqlite3.
FRAMEPAGE_DATABASE_PATH=

# Replace outside throwaway local development.
FRAMEPAGE_TOKEN_SECRET=replace-with-a-long-random-value
FRAMEPAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRAMEPAGE_MAX_VIDEO_SECONDS=7200
FRAMEPAGE_MAX_DOWNLOAD_BYTES=2147483648
FRAMEPAGE_ARTIFACT_TTL_HOURS=24
FRAMEPAGE_SIGNED_URL_SECONDS=300
FRAMEPAGE_MAX_REQUEST_BYTES=1048576
FRAMEPAGE_RATE_LIMIT=180

# Required only when FRAMEPAGE_MODE=real. Never expose this value to the browser.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
